# Copy to .env and fill in. Never commit .env.
MESH_API_KEY=
TAVILY_API_KEY=

DATA_DIR=data
DATABASE_URL=sqlite:///data/deepdive.db

# Models (all routed through Mesh). Verifier must be a different family than drafter.
MODEL_PLANNER=openai/gpt-5-nano
MODEL_DRAFTER=openai/gpt-5-nano
MODEL_SYNTHESIZER=openai/gpt-5-nano
MODEL_CONTRADICTIONS=openai/gpt-5-nano
MODEL_VERIFIER=anthropic/claude-haiku-5.5
MODEL_JUDGE=google/gemini-2.5-flash-lite
MODEL_EMBED=google/embeddinggemma-300m
MODEL_MODERATION=openai/omni-moderation-latest

MIN_SUPPORTED_CLAIMS=2
MAX_EXTRA_ROUNDS=2
QUOTE_MATCH_THRESHOLD=90

SEARCH_RESULTS_PER_QUERY=5
CHUNK_WORDS=600
CHUNK_OVERLAP_WORDS=75
CHUNK_MAX_CHARS=3000
EMBED_MAX_CHARS=2400
EMBED_FALLBACK_CHARS=1000
MAX_CHUNKS_PER_SOURCE=40
TOP_K_CHUNKS=6

LLM_MAX_RETRIES=5
LLM_RPM=80
LLM_TIMEOUT_RETRIES=1
LLM_CONCURRENCY=8
# Report writer thinks less: much faster, similar reports (empty = model default)
REASONING_EFFORT_SYNTHESIZER=low

# Google sign-in (docs/DEPLOY.md, "Google sign-in"). SESSION_SECRET signs the login cookie:
# generate one with  python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Public hostname on the server only (sign-in returns there over HTTPS); leave empty locally
SITE_HOST=
# Shown on the Privacy and Terms pages
CONTACT_EMAIL=

# Reports each Google account may create (failed runs don't count); comma-separated emails
# listed in UNLIMITED_EMAILS have no limit
FREE_REPORTS_PER_USER=5
UNLIMITED_EMAILS=

RUNS_PER_HOUR=10
MODERATION_TIMEOUT_S=10
MAX_CONCURRENT_RUNS=2

LLM_TIMEOUT_S=180
